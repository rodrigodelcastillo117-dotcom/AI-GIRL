{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/guia/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/aguinaldo",
      "destination": "/aguinaldo.html"
    },
    {
      "source": "/te-alcanza-tu-sueldo",
      "destination": "/te-alcanza-tu-sueldo.html"
    },
    {
      "source": "/finiquito",
      "destination": "/finiquito.html"
    },
    {
      "source": "/interes-compuesto",
      "destination": "/interes-compuesto.html"
    },
    {
      "source": "/regla-50-30-20",
      "destination": "/regla-50-30-20.html"
    },
    {
      "source": "/fondo-de-emergencia",
      "destination": "/fondo-de-emergencia.html"
    },
    {
      "source": "/pagar-deudas",
      "destination": "/pagar-deudas.html"
    },
    {
      "source": "/reglas",
      "destination": "/reglas.html"
    },
    {
      "source": "/hoy",
      "destination": "/hoy.html"
    },
    {
      "source": "/noticias/:fecha",
      "destination": "/noticias/:fecha.html"
    }
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . 2>/dev/null; test $? -eq 0"
}
