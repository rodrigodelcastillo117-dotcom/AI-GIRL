__pycache__/
*.pyc
venv*/
.env
*.ass
*-guia.jpg
# Videos largos: pesan ~85 MB y se vuelven a armar en minutos con scripts/compilar.py
videos/largos/
# De cada Short se guarda solo el final subtitulado (el crudo sigue en OpenArt por su id)
videos/*.mp4
!videos/*-SUBTITULADO.mp4
# Producto de paga: no va al repo (es público); se entrega en Hotmart
producto/plantilla/*.xlsx

# Carruseles: se vuelven a dibujar desde contenido/carruseles.json
carruseles/
